# 版本控制
.git
.gitignore

# Python 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# 数据库文件（容器内使用 PostgreSQL，不携带 SQLite）
*.db
*.sqlite

# 环境变量（已在各环境独立配置，不进入镜像）
.env
.env.local

# 本地开发配置
.pytest_cache/
.python_version
.mypy_cache/
.ruff_cache/

# 文档和测试（运行时不需要）
docs/
tests/
*.md

# 系统文件
.DS_Store
Thumbs.db